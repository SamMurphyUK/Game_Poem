  defaultLines:
  - I have nothing left to say.
  byStage:
  - stage: 0
    lines:
    - I have been standing here a long time.
    - Something of you is missing.
  - stage: 1
    lines:
    - You are not what you were.
    - It suits you, what you took.
  - stage: 2
    lines:
    - There is little left to join.
    - Stay. We are nearly whole.
