  defaultLines:
  - 'Why hello there. '
  byStage:
  - stage: 0
    lines:
    - I have been standing here a long time.
    - It's getting crowded in here.
  - stage: 1
    lines:
    - I think we should see other triangles.
    - I'll never forget this.
    - We keep growing. And growing.
    - I'd look good in purple.
  - stage: 2
