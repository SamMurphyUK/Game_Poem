# Auto detect text files and perform LF normalization
* text=auto

# Unity serialises scenes, prefabs and assets as YAML (Force Text is on), so
# hand them to Unity's SmartMerge rather than git's line based text merge,
# which does not understand that a scene is a set of independent objects.
# Each clone points git at the tool once:
#   git config merge.unityyamlmerge.name "Unity SmartMerge"
#   git config merge.unityyamlmerge.driver "'C:/Program Files/Unity/Hub/Editor/6000.6.0f1/Editor/Data/Tools/UnityYAMLMerge.exe' merge -p --force %O %B %A %A"
#   git config merge.unityyamlmerge.recursive binary
# Git falls back to its normal merge where that config is missing, so this is
# safe on machines that have not run it.
*.unity merge=unityyamlmerge
*.prefab merge=unityyamlmerge
*.asset merge=unityyamlmerge
*.mat merge=unityyamlmerge
*.anim merge=unityyamlmerge
*.controller merge=unityyamlmerge
